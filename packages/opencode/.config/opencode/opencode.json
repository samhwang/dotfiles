{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "{env:HOME}/.dotfiles/plugins/ponytail/.opencode/plugins/",
    "{env:HOME}/.dotfiles/plugins/i-have-adhd/.opencode/plugins/",
    "{env:HOME}/.dotfiles/plugins/caveman/plugin.js"
  ],
  "model": "opencode/big-pickle",
  "agents": {
    "title": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "providers": {
    "anthropic": {
      "models": {},
      "settings": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "openrouter": {
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}
